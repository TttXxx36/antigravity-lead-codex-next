{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task_id",
    "rev",
    "base_rev",
    "process_status",
    "task_status",
    "verification_status",
    "exit_code",
    "summary",
    "risks",
    "blockers",
    "worker_verification_claim",
    "process_error",
    "duration_ms",
    "usage",
    "git",
    "result_ref"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "task_id": {
      "type": "string"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "base_rev": {
      "type": "integer",
      "minimum": 0
    },
    "process_status": {
      "enum": [
        "timed_out",
        "launch_failed",
        "exited",
        "failed"
      ]
    },
    "task_status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "verification_status": {
      "enum": [
        "unknown",
        "not_run"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "summary": {
      "type": "string",
      "maxLength": 320
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worker_verification_claim": {
      "enum": [
        "passed",
        "failed",
        "not_run",
        "unknown"
      ]
    },
    "process_error": {
      "type": "boolean"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "counts"
      ],
      "properties": {
        "source": {
          "enum": [
            "unknown",
            "cli_reported"
          ]
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cached_input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "reasoning_output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_sha",
        "base_sha"
      ],
      "properties": {
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "result_ref": {
      "type": "string"
    }
  }
}
