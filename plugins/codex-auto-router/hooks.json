{
  "allow-multi-agent-dispatch": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/allow_dispatch.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
